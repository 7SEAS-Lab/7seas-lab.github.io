---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
---

<Layout title="Research" active="Research">
  <div class="container">
    <header class="page-heading">
      <p class="eyebrow">Research & open source</p>
      <h1>
        Methods that scale.
        <br />
        <span class="serif-accent">Science that moves forward.</span>
      </h1>
      <p>
        We connect AI methods and high-performance computing with scientific
        questions. Explore selected research and open-source projects involving our team.
      </p>
    </header>
    <div class="project-list">
      {projects.map((p, i) => (
        <article class="project-row">
          <a
            class="project-image"
            href={`/research/${p.slug}/`}
            aria-label={`Explore ${p.name}`}
          >
            <img
              src={p.image}
              alt={`${p.name}: ${p.category} illustration`}
              width="680"
              height="440"
            />
          </a>
          <div class="project-copy">
            <p class="eyebrow">
              0{i + 1} / {p.category}
            </p>
            <h2>
              <a href={`/research/${p.slug}/`}>
                {p.name} <span>↗</span>
              </a>
            </h2>
            <p class="project-subtitle">{p.subtitle}</p>
            <p>{p.abstract}</p>
            <div class="project-links">
              <a class="text-link" href={`/research/${p.slug}/`}>
                Explore project →
              </a>
              {p.github && <a class="text-link" href={p.github}>GitHub ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
  <section class="research-cta container">
    <h2>Have a scientific challenge?</h2>
    <a class="button" href="/#contact">
      Let’s explore it together ↗
    </a>
  </section>
</Layout>
