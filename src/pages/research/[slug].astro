---
import Layout from "../../layouts/Layout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { publications } from "../../data/publications";
import { projects } from "../../data/projects";
import { team } from "../../data/team";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const projectPublications = publications.filter((publication) => publication.projects.includes(project.slug));
---

<Layout title={project.name} description={project.abstract} active="Research">
  <article class="container detail-page">
    <a class="back-link" href="/research/">
      ← All research
    </a>
    <header class="page-heading">
      <p class="eyebrow">{project.category} / {project.github ? "Open-source project" : "Research project"}</p>
      <h1>{project.name}</h1>
      <p>{project.subtitle}</p>
    </header>
    <img
      class="project-banner"
      src={project.image}
      alt={`${project.name}: ${project.category} illustration`}
      width="1100"
      height="500"
    />
    <div class="detail-columns">
      <div class="prose">
        <h2>About the project</h2>
        <p>{project.description}</p>
        <h3>What it enables</h3>
        <ul>
          {project.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
        <h3>Explore the project</h3>
        <p>
          {project.github ? "The project repository provides source code, documentation, and contribution guidance." : "Explore the linked research resource for background, methods, and project details."}
        </p>
        <a class="button" href={project.github ?? project.reference}>
          {project.github ? "View on GitHub ↗" : "Explore research ↗"}
        </a>
      </div>
      <aside class="profile-aside">
        <p class="eyebrow">People at 7SEAS</p>
        {project.members.map((slug) => {
          const member = team.find((m) => m.slug === slug)!;
          return (
            <a class="mini-member" href={`/team/${slug}/`}>
              {member.image && <img src={member.image} alt="" width="38" height="38" style={member.slug === "markus-goetz" ? "object-position: center top" : undefined} />}
              {member.name} ↗
            </a>
          );
        })}
        <p class="eyebrow aside-label">Project resources</p>
        {project.github && <a href={project.github}>Source & documentation ↗</a>}
        <a href={project.reference}>Research reference ↗</a>
        <p class="image-credit">
          Project description based on the linked {project.github ? "repository" : "research resource"}. Illustrations by
          7SEAS Lab.
        </p>
      </aside>
    </div>
    {projectPublications.length > 0 && (
      <section class="related-section">
        <p class="eyebrow">Papers & preprints</p>
        <h2>Related publications</h2>
        {projectPublications.map((publication) => <PublicationCard publication={publication} />)}
      </section>
    )}
  </article>
</Layout>
