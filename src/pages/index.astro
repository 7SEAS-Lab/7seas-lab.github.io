---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import MemberCard from "../components/MemberCard.astro";
import { principles, fields, site } from "../data/site";
import { team } from "../data/team";
---

<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Research across boundaries
      </p>
      <h1>
        Better AI.
        <br />
        Bigger possibilities
        <br />
        for <span class="serif-accent">science.</span>
      </h1>
      <p class="hero-description">
        We develop scalable and efficient AI to make scientific discovery more
        effective, sustainable, and accessible.
      </p>
      <div class="hero-actions">
        <a class="button" href="/research/">
          Explore our research <span>↗</span>
        </a>
        <a class="text-link" href="#about">
          Get to know us <span>↓</span>
        </a>
      </div>
    </div>
    <div class="hero-art">
      <img
        class="hero-logo"
        src="/images/7seas.svg"
        alt="7SEAS — Scalable and Efficient AI for Science"
        width="938"
        height="373"
        fetchpriority="high"
      />
      <span class="art-label art-label-top">
        <span class="status-dot"></span> Methods that scale
      </span>
      <span class="art-label art-label-bottom">
        Discovery that matters <span>↗</span>
      </span>
    </div>
  </section>
  <div class="mission-strip">
    <div class="container">
      <span>One shared ambition</span>
      <p>
        Accelerate research <span>↗</span>
      </p>
      <p>
        Improve efficiency <span>↗</span>
      </p>
      <p>
        Enable scientific innovation <span>↗</span>
      </p>
    </div>
  </div>
  <section id="about" class="section container about-section">
    <div>
      <p class="eyebrow">01 / About the lab</p>
      <h2>
        Scientific questions.
        <br />
        <span class="serif-accent">Computational possibilities.</span>
      </h2>
    </div>
    <div class="about-copy">
      <p class="lead">
        7SEAS Lab is a research collaboration advancing scalable and efficient
        AI for scientific discovery.
      </p>
      <p>
        Across disciplines, scientific progress increasingly relies on
        computational methods to analyse data, model complex systems, and
        generate new hypotheses. The growing scale of AI brings new challenges:
        efficiency, accessibility, reproducibility, and scientific rigor.
      </p>
      <p>
        We address these challenges through rigorous research on scalable
        training and inference, interdisciplinary collaboration, and a focus on
        real-world impact.
      </p>
      <p>
        This is our hub for research publications, open-source projects,
        technical perspectives, and opportunities to work together.
      </p>
    </div>
  </section>
  <section class="principles-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Our research compass</p>
          <h2>
            Seven principles.
            <br />
            <span class="serif-accent">A sea of possibilities.</span>
          </h2>
        </div>
        <p>
          From the algorithms we design to the science they enable, these ideas
          guide our work.
        </p>
      </div>
      <div class="seven-grid principles-grid">
        {principles.map((p, i) => (
          <article>
            <span class="small-number">0{i + 1}</span>
            <Icon name={p.icon} size={44} />
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="fields-header">
        <span class="eyebrow">Seven fields of application</span>
        <span class="fine-line"></span>
        <span class="muted">Connected by AI</span>
      </div>
      <div class="seven-grid fields-grid">
        {fields.map((f) => (
          <div>
            <span class="field-icon">
              <Icon name={f.icon} size={38} />
            </span>
            <h3>{f.name}</h3>
          </div>
        ))}
      </div>
      <a class="text-link concept-link" href="/images/7seas-concept.png">
        View the original 7SEAS concept <span>↗</span>
      </a>
    </div>
  </section>
  <section id="team" class="section container team-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / The people behind the research</p>
        <h2>
          Meet the <span class="serif-accent">team.</span>
        </h2>
      </div>
      <p>
        Different perspectives. Shared curiosity.
        <br />
        Working together at Karlsruhe Institute of Technology.
      </p>
    </div>
    <div class="team-grid">
      {team
        .filter((m) => m.founder)
        .map((member) => (
          <MemberCard member={member} />
        ))}
    </div>
    {team.some((m) => !m.founder) && (
      <>
        <h3 class="team-subheading">Researchers & collaborators</h3>
        <div class="team-grid">
          {team
            .filter((m) => !m.founder)
            .map((member) => (
              <MemberCard member={member} />
            ))}
        </div>
      </>
    )}
    <div class="team-note">
      <span class="status-dot"></span>
      <p>Science moves forward through collaboration.</p>
      <a class="text-link" href="#contact">
        Work with us ↗
      </a>
    </div>
  </section>
  <section id="contact" class="contact-section">
    <div class="container contact-inner">
      <div>
        <p class="eyebrow">03 / Let’s get in touch</p>
        <h2>
          Good science starts
          <br />
          with a <span class="serif-accent">conversation.</span>
        </h2>
        <p>
          Have a research question, a collaboration in mind, or an interest in
          our open-source work? We’d love to hear from you.
        </p>
      </div>
      <div class="contact-details">
        <span class="contact-label">Connect with the lab</span>
        <a class="contact-email" href={`mailto:${site.email}`}>
          {site.email} <span>↗</span>
        </a>
        <p>Contact the 7SEAS Lab team</p>
        <div class="contact-other">
          {team
            .filter((m) => m.email !== site.email)
            .map((m) => (
              <a href={`mailto:${m.email}`}>
                {m.name} <span>↗</span>
              </a>
            ))}
        </div>
        <span class="location">
          Karlsruhe, Germany · Working across disciplines
        </span>
      </div>
    </div>
  </section>
</Layout>
