---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("blog", ({ data }) => !data.draft)).map(
    (post) => ({ params: { id: post.id }, props: { post } }),
  );
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  active="Blog"
>
  <article class="container detail-page article-page">
    <a class="back-link" href="/blog/">
      ← Back to the blog
    </a>
    <header class="page-heading">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </header>
    <div class="post-meta">
      <span>{post.data.author}</span>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
          timeZone: "Europe/Berlin",
        })}
      </time>
    </div>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      <a href="/blog/">← All posts</a>
      <a href="/#contact">Start a conversation ↗</a>
    </footer>
  </article>
</Layout>
