---
import Layout from "../layouts/Layout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { labPublications as publications } from "../data/publications";
const years = [...new Set(publications.map((p) => p.year))];
---

<Layout title="Publications" active="Publications">
  <div class="container">
    <header class="page-heading">
      <p class="eyebrow">Papers & preprints</p>
      <h1>
        Research, shared.
        <br />
        <span class="serif-accent">Knowledge, advanced.</span>
      </h1>
      <p>
        Publications from 7SEAS research, from scalable algorithms to
        scientific applications. Explore the papers and the ideas behind them.
      </p>
    </header>
    <div class="pub-toolbar">
      <label class="pub-search">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">Search publications by title or author</span>
        <input
          id="publication-search"
          type="search"
          placeholder="Search by title or author…"
        />
      </label>
      <label>
        <span class="sr-only">Filter by year</span>
        <select id="publication-year">
          <option value="all">All years</option>
          {years.map((y) => (
            <option value={y}>{y}</option>
          ))}
        </select>
      </label>
      <span class="pub-count" aria-live="polite">
        {publications.length} publications
      </span>
      <a class="text-link" href="/publications.bib" download>
        Download BibTeX ↓
      </a>
    </div>
    <div class="publications-section">
      {years.map((year) => (
        <section
          class="publication-year"
          data-year={year}
          aria-label={`${year} publications`}
        >
          <h2>{year}</h2>
          <div>
            {publications
              .filter((p) => p.year === year)
              .map((p) => (
                <PublicationCard publication={p} />
              ))}
          </div>
        </section>
      ))}
      <p class="empty-state" hidden>
        No publications match your search.
      </p>
    </div>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>(
      "#publication-search",
    );
    const year = document.querySelector<HTMLSelectElement>("#publication-year");
    function filterPublications() {
      const query = input?.value.trim().toLocaleLowerCase() ?? "";
      let count = 0;
      document
        .querySelectorAll<HTMLElement>(".publication-year")
        .forEach((section) => {
          let visible = 0;
          section
            .querySelectorAll<HTMLElement>(".publication")
            .forEach((publication) => {
              const match =
                (year?.value === "all" ||
                  year?.value === section.dataset.year) &&
                (publication.dataset.search?.includes(query) ?? false);
              publication.hidden = !match;
              if (match) {
                visible++;
                count++;
              }
            });
          section.hidden = visible === 0;
        });
      const counter = document.querySelector(".pub-count");
      if (counter)
        counter.textContent = `${count} publication${count === 1 ? "" : "s"}`;
      const empty = document.querySelector<HTMLElement>(".empty-state");
      if (empty) empty.hidden = count > 0;
    }
    input?.addEventListener("input", filterPublications);
    year?.addEventListener("change", filterPublications);
  </script>
</Layout>
